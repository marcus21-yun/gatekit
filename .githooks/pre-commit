#!/bin/sh
set -eu

run_python() {
  python3 "$@" || python "$@" || py "$@"
}

if ! (cd .claude/gatekit-core && run_python -m unittest discover -s tests); then
  echo "pre-commit: gatekit unit tests failed; commit aborted." >&2
  exit 1
fi

for gate in tools/gate_*.py; do
  if ! run_python "$gate"; then
    echo "pre-commit: $gate failed; commit aborted." >&2
    exit 1
  fi
done
